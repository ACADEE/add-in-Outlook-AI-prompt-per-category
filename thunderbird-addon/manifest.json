{
  "manifest_version": 2,
  "name": "Thunderbird AI Draft",
  "version": "0.1.0",
  "description": "Génère des brouillons de réponse email via OpenAI basés sur les catégories",
  "author": "ACADEE",

  "applications": {
    "gecko": {
      "id": "thunderbird-ai-draft@acadee.local",
      "strict_min_version": "102.0"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "messagesRead",
    "compose",
    "storage"
  ],

  "background": {
    "scripts": ["src/background.js"]
  },

  "compose_action": {
    "default_title": "AI Draft",
    "default_icon": "icons/icon-32.png",
    "default_popup": "src/compose-popup.html"
  },

  "message_display_action": {
    "default_title": "AI Draft",
    "default_icon": "icons/icon-32.png",
    "default_popup": "src/message-popup.html"
  }
}
